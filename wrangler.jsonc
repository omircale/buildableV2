{
	// The site is a Worker: /api/* runs worker/index.ts (accounts, folders, bills on D1), and every other
	// request is served from the built app. The app routes on the hash, so unknown paths get index.html.
	"name": "buildable",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-22",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Not a secret: Google shows the client ID to every browser that signs in. The client secret and the
	// bootstrap admin address are set with `wrangler secret put` and never live in this file.
	"vars": {
		"GOOGLE_CLIENT_ID": "635321102821-lrj6egfoastsk1logor5eojda3dl84ti.apps.googleusercontent.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buildable",
			"database_id": "0082affb-3488-4d17-bfdd-db3ccc90be2f",
			"remote": true
		}
	],
	// Buildable for hospitality: the same code built with `--mode hospitality`, served from its own Worker.
	// It shares the database, so one account works on both sites. Bindings and vars are not inherited by
	// an environment, so they are repeated here.
	"env": {
		"hospitality": {
			"name": "buildable-hospitality",
			"assets": {
				"directory": "./dist-hospitality",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application",
				"run_worker_first": ["/api/*"]
			},
			"vars": {
				"GOOGLE_CLIENT_ID": "635321102821-lrj6egfoastsk1logor5eojda3dl84ti.apps.googleusercontent.com"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "buildable",
					"database_id": "0082affb-3488-4d17-bfdd-db3ccc90be2f",
					"remote": true
				}
			]
		}
	}
}
